project "oatmeal" {
    version = "0.1.0"

    executable "oatmeal" {
        sources = [
            "src/main.mm",
            "src/platform/macos/application.mm",
            "src/platform/macos/overlay/overlay.mm",
            "src/platform/macos/input/listener.mm",
            "src/platform/macos/menu/menu.mm",
            "src/platform/macos/settings/settings.mm",
            "src/core/shortcut.cpp",
            "src/core/config.cpp",
            "src/core/aggregation.cpp"
        ]
        include_dirs = ["src"]
        flags = ["-std=c++20", "-Wall", "-Wextra", "-pedantic"]
        linker_flags = ["build/debug/oatmeal/SettingsView.o", "-framework", "AppKit", "-framework", "Foundation", "-framework", "ApplicationServices", "-framework", "Carbon", "-framework", "SwiftUI"]
    }
}
